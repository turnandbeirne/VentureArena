# Copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API in the Supabase dashboard, reachable from your
# Lovable project's Supabase panel). Both are safe to expose to the browser
# — they're the public anon key, not the service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
